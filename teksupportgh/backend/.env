# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=teksupportgh
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Secret
JWT_SECRET=teksupportgh-secret-key-2024-change-in-production

# Firebase Configuration (Add your Firebase credentials)
FIREBASE_PROJECT_ID=teksupportgh-demo
FIREBASE_PRIVATE_KEY=demo-key
FIREBASE_CLIENT_EMAIL=demo@teksupportgh.iam.gserviceaccount.com

# Hubtel Payment Configuration (Add your Hubtel credentials)
HUBTEL_CLIENT_ID=demo-client-id
HUBTEL_CLIENT_SECRET=demo-client-secret
HUBTEL_MERCHANT_ACCOUNT=HM00000
HUBTEL_API_URL=https://api.hubtel.com/v1

# Google Maps API
GOOGLE_MAPS_API_KEY=demo-google-maps-key

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Payment Callback URL
PAYMENT_CALLBACK_URL=http://localhost:5000/api/payments/callback
